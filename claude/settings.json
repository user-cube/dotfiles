{
  "permissions": {
    "deny": [
      "Read(//**/age-key.txt*)",
      "Read(//**/*.agekey)",
      "Read(//**/.env)",
      "Read(//**/.envrc)",
      "Read(//**/env.php*)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/.aws/credentials)",
      "Read(//**/.ssh/id_*)",
      "Read(//**/config/database.yml)"
    ],
    "allow": [
      "Bash(go vet ./...)",
      "Bash(gofmt -l *)",
      "Bash(shellcheck *)",
      "mcp__grafana__query_loki_logs",
      "mcp__grafana__query_prometheus",
      "mcp__ccd_pr__get_status",
      "mcp__bookstack__bookstack_pages_read",
      "mcp__bookstack__bookstack_books_read",
      "mcp__bookstack__bookstack_search",
      "mcp__superlogical__search_docs",
      "mcp__superlogical__read_doc",
      "mcp__superlogical__get_feedback",
      "mcp__superlogical__search_feedback",
      "mcp__superlogical__search_changelog",
      "mcp__kubernetes-mcp-server__pods_list",
      "mcp__Claude_Browser__find",
      "mcp__Claude_Browser__get_page_text"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(rtk git commit:*)",
      "Bash(git push:*)",
      "Bash(rtk git push:*)",
      "Bash(git -C * commit*)",
      "Bash(git -C * push*)"
    ]
  },
  "model": "opus",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline/statusline",
    "refreshInterval": 15
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/deny-sensitive-reads/deny-sensitive-reads || { echo 'deny-sensitive-reads is not built: run dotfiles-sync' >&2; exit 2; }",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/write-guard/write-guard || { echo 'write-guard is not built: run dotfiles-sync' >&2; exit 2; }",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/git-guard/git-guard || { echo 'git-guard is not built: run dotfiles-sync' >&2; exit 2; }",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/kube-guard/kube-guard claude-hook || { echo 'kube-guard is not built: run dotfiles-sync' >&2; exit 2; }",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-check/stop-check",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "i-have-adhd@i-have-adhd": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "verbose": true,
  "viewMode": "verbose"
}

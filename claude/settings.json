{
  "permissions": {
    "deny": [
      "Read(//**/age-key.txt*)",
      "Read(//**/*.agekey)",
      "Read(//**/.env)",
      "Read(//**/.envrc)",
      "Read(//**/env.php*)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/.aws/credentials)",
      "Read(//**/.ssh/id_*)",
      "Read(//**/config/database.yml)"
    ]
  },
  "model": "opus",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/deny-sensitive-reads/deny-sensitive-reads || { echo 'deny-sensitive-reads is not built: run dotfiles-sync' >&2; exit 2; }",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "i-have-adhd@i-have-adhd": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "verbose": true,
  "viewMode": "verbose"
}

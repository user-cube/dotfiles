[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[user]
    name = Rui

[includeIf "gitdir:~/work/"]
    path = ~/.gitconfig-work

# My own repos, by the remote: the account's address on GitHub or GitLab. They
# live under ~/work/ too, so these come after it and win
[includeIf "hasconfig:remote.*.url:git@github.com:user-cube/**"]
    path = ~/.gitconfig-personal-github
[includeIf "hasconfig:remote.*.url:https://github.com/user-cube/**"]
    path = ~/.gitconfig-personal-github
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/user-cube/**"]
    path = ~/.gitconfig-personal-github
[includeIf "hasconfig:remote.*.url:git@gitlab.com:user-cube/**"]
    path = ~/.gitconfig-personal-gitlab
[includeIf "hasconfig:remote.*.url:https://gitlab.com/user-cube/**"]
    path = ~/.gitconfig-personal-gitlab
[includeIf "hasconfig:remote.*.url:ssh://git@gitlab.com/user-cube/**"]
    path = ~/.gitconfig-personal-gitlab

# The global hooks: their own file, .gitconfig-hooks
[include]
    path = ~/.gitconfig-hooks

[push]
    autoSetupRemote = true
    followTags = true            # annotated tags of the pushed commits go along

[init]
    defaultBranch = main
[pull]
    rebase = true                # no merge commit for "the remote moved"
[rebase]
    autoStash = true             # uncommitted changes are stashed and put back
    autoSquash = true            # fixup!/squash! commits land in place
[fetch]
    prune = true                 # branches deleted on the remote go here too
    pruneTags = true
[merge]
    conflictStyle = zdiff3       # conflicts show the common ancestor as well
[rerere]
    enabled = true               # a conflict resolved once resolves itself next time
    autoUpdate = true            # and lands staged, no git add
[core]
    fsmonitor = true             # git status asks a file watcher, not the whole tree
    untrackedCache = true
[commit]
    verbose = true               # the diff under the message, in the editor
[gpg "ssh"]
    allowedSignersFile = ~/.config/git/allowed_signers   # git log --show-signature verifies my commits
[diff]
    algorithm = histogram        # more readable hunks than the default myers
    colorMoved = default         # moved lines in another color
[branch]
    sort = -committerdate        # git branch: most recent first
[tag]
    sort = -version:refname      # git tag: newest version first
[column]
    ui = auto                    # git branch / tag / status lists in columns
[help]
    autocorrect = prompt         # a mistyped command offers the right one

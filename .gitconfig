[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[user]
    name = Rui Coelho

[includeIf "gitdir:~/work/"]
    path = ~/.gitconfig-work

[includeIf "gitdir:~/personal/"]
    path = ~/.gitconfig-personal

# Personal GitHub repos live under ~/work/ too, so match on the remote rather
# than the path. Listed last so it wins over the gitdir conditions above.
[includeIf "hasconfig:remote.*.url:*:user-cube/**"]
    path = ~/.gitconfig-personal

[hook "gitleaks"]
    event = pre-commit
    command = gitleaks git --staged --redact --verbose

# Staged GitHub Actions workflows through actionlint (git_hooks/actionlint)
[hook "actionlint"]
    event = pre-commit
    command = ~/git_hooks/actionlint/pre-commit

# Staged .gitlab-ci.yml through the GitLab API, glab ci lint (git_hooks/gitlab-ci-lint)
[hook "gitlab-ci-lint"]
    event = pre-commit
    command = ~/git_hooks/gitlab-ci-lint/pre-commit

# Conventional Commit prefix + issue key from the branch; blocks main/master/develop.
# Built by dotfiles-sync / the playbook; disabled for personal repos (.gitconfig-personal)
[hook "commit-msg-go"]
    event = commit-msg
    command = ~/git_hooks/go/commit-msg/commit-msg
[push]
    autoSetupRemote = true
    followTags = true            # annotated tags of the pushed commits go along

[init]
    defaultBranch = main
[pull]
    rebase = true                # no merge commit for "the remote moved"
[rebase]
    autoStash = true             # uncommitted changes are stashed and put back
    autoSquash = true            # fixup!/squash! commits land in place
[fetch]
    prune = true                 # branches deleted on the remote go here too
    pruneTags = true
[merge]
    conflictStyle = zdiff3       # conflicts show the common ancestor as well
[rerere]
    enabled = true               # a conflict resolved once resolves itself next time
[diff]
    algorithm = histogram        # more readable hunks than the default myers
    colorMoved = default         # moved lines in another color
[branch]
    sort = -committerdate        # git branch: most recent first
[tag]
    sort = -version:refname      # git tag: newest version first
[column]
    ui = auto                    # git branch / tag / status lists in columns
[help]
    autocorrect = prompt         # a mistyped command offers the right one

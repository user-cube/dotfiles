# ============================================
# Ghostty Terminal
# ============================================
# File: ~/.config/ghostty/config
# Reload: Cmd+Shift+, (macOS)
# View options: ghostty +show-config --default --docs

# --- Typography ---
font-family = JetBrainsMonoNerdFont
font-size = 14
font-thicken = true
adjust-cell-height = 2

# --- Theme and Colors ---
# Monokai Soda
theme = Monokai Soda

# --- Window and Appearance ---
background-opacity = 0.9
background-blur-radius = 20
macos-titlebar-style = transparent
window-padding-x = 10
window-padding-y = 8
window-save-state = always
window-theme = auto

# --- Cursor ---
cursor-style = bar
cursor-style-blink = true
cursor-opacity = 0.8

# --- Mouse ---
mouse-hide-while-typing = true
copy-on-select = clipboard

# --- Quick Terminal (Quake-style dropdown) ---
# Activate with the global keybind configured below
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15

# --- Security ---
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true

# --- Shell Integration ---
shell-integration = detect
shell-integration-features = ssh-terminfo,ssh-env,cursor,no-sudo,title

# --- Keybindings ---
# Tabs, splits and sessions are tmux's (Ghostty's native tabs are separate macOS
# windows and AeroSpace tiles each one). These ⌘ shortcuts send the tmux prefix
# (C-b = \x02) plus a key; see ~/.config/tmux/tmux.conf.

# Tabs (tmux windows)
keybind = cmd+t=text:\x02c
keybind = cmd+shift+left=text:\x02p
keybind = cmd+shift+right=text:\x02n
keybind = cmd+w=text:\x02X
# Both forms: Ghostty's defaults bind super+N and super+digit_N to goto_tab
keybind = cmd+digit_1=text:\x021
keybind = cmd+1=text:\x021
keybind = cmd+digit_2=text:\x022
keybind = cmd+2=text:\x022
keybind = cmd+digit_3=text:\x023
keybind = cmd+3=text:\x023
keybind = cmd+digit_4=text:\x024
keybind = cmd+4=text:\x024
keybind = cmd+digit_5=text:\x025
keybind = cmd+5=text:\x025
keybind = cmd+digit_6=text:\x026
keybind = cmd+6=text:\x026
keybind = cmd+digit_7=text:\x027
keybind = cmd+7=text:\x027
keybind = cmd+digit_8=text:\x028
keybind = cmd+8=text:\x028
keybind = cmd+digit_9=text:\x029
keybind = cmd+9=text:\x029

# Splits (tmux panes)
keybind = cmd+d=text:\x02%
keybind = cmd+shift+d=text:\x02"
keybind = cmd+alt+left=text:\x02h
keybind = cmd+alt+right=text:\x02l
keybind = cmd+alt+up=text:\x02k
keybind = cmd+alt+down=text:\x02j
keybind = cmd+shift+e=text:\x02E
keybind = cmd+shift+f=text:\x02z

# Sessions: pick / switch (tmux tree)
keybind = cmd+shift+s=text:\x02s
# Open a repo as a session (fuzzy finder over ~/work)
keybind = cmd+o=text:\x02f
# Open an ssh host (from the ssh config) in a new tab
keybind = cmd+shift+o=text:\x02O
# lazygit for the current folder, in a popup
keybind = cmd+g=text:\x02g
# side-by-side diff of the working tree (lumen), in a popup
keybind = cmd+shift+g=text:\x02G
# yazi file manager in the current folder, in a popup
keybind = cmd+e=text:\x02e
# lazydocker, in a popup
keybind = cmd+shift+l=text:\x02D
# k9s on the current kube context, in a popup (replaces Ghostty's clear screen;
# inside tmux use `clear` or ctrl+l)
keybind = cmd+k=text:\x02K
# scratch terminal popup (persistent); press again to close
keybind = cmd+j=text:\x02J
# select all (tmux copy mode over the whole pane history; y / enter copies)
keybind = cmd+a=text:\x02a

# Font size
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Quick terminal global hotkey
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# Reload config
keybind = cmd+shift+comma=reload_config

# --- Performance ---
# Generous scrollback (25MB)
scrollback-limit = 25000000

# -- Update Channel --
auto-update-channel = tip

# Keep fullscreen inside the window (no separate macOS Space; plays well with AeroSpace)
macos-non-native-fullscreen = true

# Every window starts inside tmux (see tmux-start.sh)
command = ~/.config/ghostty/tmux-start.sh

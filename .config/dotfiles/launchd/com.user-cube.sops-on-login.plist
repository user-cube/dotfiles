<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- At login: removes the age keys sops-on left (.config/zsh/sops.zsh, _sops_login).
     Copied to ~/Library/LaunchAgents by install.sh; launchd loads it at the next login -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user-cube.sops-on-login</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-f</string>
    <string>-c</string>
    <string>source "$HOME/.config/zsh/sops.zsh" &amp;&amp; _sops_login</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>

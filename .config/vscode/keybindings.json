[
  {
    "key": "cmd+k cmd+s",
    "command": "hue.goToFolder",
    "when": "workspaceFolderCount > 0"
  },
  {
    "key": "cmd+k",
    "command": "-workbench.action.terminal.clear"
  },
  {
    "key": "shift+enter",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u001b\r"
    },
    "when": "terminalFocus"
  }
]

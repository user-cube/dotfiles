#!/bin/bash
# Tab completion for a kubectl plugin: kubectl runs kubectl_complete-<plugin> with
# the words after the plugin name (the last one is being typed) and reads one
# completion per line, then :<directive> (4 = no file names). On PATH from .zshrc.
# kubectl who-can VERB RESOURCE [NAME]: a verb, then what kubectl get completes
if [ $# -le 1 ]; then
  printf '%s\n' get list watch create update patch delete deletecollection impersonate bind escalate use
  echo :4
  exit
fi
shift
exec kubectl __complete get "$@"
